# Clés lues par radar-agent-reach.mjs (copier en .env pour un run local,
# ou déclarer en secrets GitHub Actions pour la CI).
# Une source sans sa clé est ignorée proprement.
EXA_API_KEY=
YOUTUBE_API_KEY=
TWITTER_BEARER_TOKEN=
# Reddit : optionnel en local, indispensable en CI (403 anonyme depuis les IP GitHub).
# App « script » à créer sur https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Bluesky : optionnel. Sans compte, l'API publique marche mais refuse parfois les IP GitHub (403).
# Compte gratuit + mot de passe d'application : bsky.app → Réglages → Confidentialité et sécurité → Mots de passe d'application
BSKY_HANDLE=
BSKY_APP_PASSWORD=
